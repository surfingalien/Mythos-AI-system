# ============================================================
# Mythos AI - Environment Configuration Template
# Copy this file to ".env" and fill in your real values.
#   cp .env.example .env
# NEVER commit your real .env file to git.
# Everything is optional — features disable gracefully.
# ============================================================

# --- OpenAI (the LLM brain: tool calling, natural conversation) ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- OpenWeatherMap (weather lookups) ---
WEATHER_API_KEY=your-openweather-api-key-here

# --- NewsAPI (news briefing) ---
NEWS_API_KEY=your-newsapi-key-here
NEWS_COUNTRY=us

# --- Email (SMTP) ---
# For Gmail, generate an "App Password" at:
#   https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465

# Contacts for "send an email to <name>":
# CONTACTS=john:john@example.com,boss:boss@company.com

# --- Assistant behavior ---
ASSISTANT_NAME=Mythos
DEFAULT_CITY=New York
WAKE_WORD=mythos

# --- Audio engines (auto picks the best installed option) ---
# TTS_ENGINE=auto            # auto | edge | pyttsx3
# TTS_VOICE=en-US-GuyNeural  # any edge-tts voice (list: edge-tts --list-voices)
# STT_ENGINE=auto            # auto | whisper | google
# WHISPER_MODEL=base         # tiny | base | small | medium
# WAKE_ENGINE=auto           # auto | openwakeword | google
# WAKE_MODEL_PATH=           # custom openWakeWord model (.onnx); needed for
#                            # offline detection of any wake word except "jarvis"
# WAKE_THRESHOLD=0.5

# --- Spotify (optional, needs `pip install spotipy` + Premium) ---
# Create an app at https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Home Assistant (optional smart-home control) ---
# HASS_URL=http://homeassistant.local:8123
# HASS_TOKEN=your-long-lived-access-token

# --- Personal notes retrieval ("search my notes for ...") ---
# NOTES_DIR=/path/to/your/notes

# --- Long-term memory store ---
# MEMORY_PATH=mythos_memory.json

# --- Web UI (python -m mythos --web) ---
# WEB_HOST=127.0.0.1
# WEB_PORT=8765

# --- MCP servers (experimental, needs `pip install mcp`) ---
# MCP_CONFIG=mcp_servers.json
